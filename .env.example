# Copie para .env e preencha. Nunca envie .env para o Git.

# App no PC usando a API no Railway (só depois das chaves oficiais):
# JDS_API_URL=https://garimpo-jds-production-b6d8.up.railway.app

# Amazon Product Advertising API (Associates)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# Amazon Brasil (associados.amazon.com.br)
AMAZON_PARTNER_TAG=jdseconomiz0e-20
# Amazon EUA (affiliate-program.amazon.com) — ID diferente do Brasil
AMAZON_TAG_US=jdseconomiza-20

# eBay Partner Network (somente mercado US, PDP /itm/{id})
EBAY_EPN_CAMPAIGN_ID=5339211741
EBAY_EPN_CUSTOM_ID=5339211530

# Shopee Affiliate Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Mercado Livre Developers (token da sua aplicação)
MELI_ACCESS_TOKEN=

# SearchApi.io (Google Shopping + Product Offers). Nunca commitar a chave.
SEARCHAPI_API_KEY=
SEARCHAPI_MAX_PRODUCT_OFFERS=3
SEARCHAPI_MAX_REQUESTS_PER_QUERY=5
SEARCHAPI_CACHE_TTL=900
SEARCHAPI_OFFERS_CACHE_TTL=900

# Scrape (Railway): ZenRows primeiro, ScrapingAnt se o ZenRows falhar
ZENROWS_API_KEY=
SCRAPINGANT_API_KEY=
SCRAPING_ANT_KEY_2=

# Token do app móvel (Railway). Se vazio, a API fica aberta.
# JDS_API_TOKEN=

# Cache SQLite (2h). No PC fica na pasta do projeto.
# No Railway, se criar um Volume montado em /data, o cache sobrevive ao deploy.
# CACHE_GARIMPO_DB=/data/cache_garimpo.db

# Copie para .env e preencha. Nunca envie .env para o Git.

# App no PC usando a API no Railway (só depois das chaves oficiais):
# JDS_API_URL=https://garimpo-jds-production-b6d8.up.railway.app

# Amazon Product Advertising API (Associates)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# Amazon Brasil (associados.amazon.com.br)
AMAZON_PARTNER_TAG=jdseconomiz0e-20
# Amazon EUA (affiliate-program.amazon.com) — ID diferente do Brasil
AMAZON_TAG_US=jdseconomiza-20

# Shopee Affiliate Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Mercado Livre Developers (token da sua aplicação)
MELI_ACCESS_TOKEN=

# Google via Serper.dev (resolve o bloqueio no Railway)
SERPER_API_KEY=

# Scrape (Railway): ZenRows primeiro, ScrapingAnt se o ZenRows falhar
ZENROWS_API_KEY=
SCRAPINGANT_API_KEY=
SCRAPING_ANT_KEY_2=

# Token do app móvel (Railway). Se vazio, a API fica aberta.
# JDS_API_TOKEN=

# 1 = abrir o Flet como site
JDS_WEB=0
